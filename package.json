{
  "name": "astrosivam-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "parity:corpus": "tsx scripts/build-parity-corpus.ts",
    "parity:node": "tsx scripts/parity-emit-node.ts",
    "parity:php": "php tests/emit-php-parity.php",
    "parity:compare": "tsx scripts/compare-parity.ts",
    "parity:seed": "npm run parity:corpus && npm run parity:node -- --write-expected",
    "test:pdf": "playwright test",
    "test:php": "bash scripts/run-php-tests.sh",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:zip": "npm run build && python3 scripts/create_dist_zip.py",
    "preview": "vite preview --host 0.0.0.0",
    "clean": "rm -rf dist dist.zip",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^5.2.0",
    "astronomy-engine": "^2.1.19",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.556.0",
    "motion": "^14.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0",
    "recharts": "^3.10.1",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tz-lookup": "^6.1.2",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
