-  4, 3, 2, 1, 0, 0, 1, 2, 3,
-  4, 3, 2, 1, 0, 0, 1, 2, 3,
-  4, 3, 2, 1, 0, 0, 1, 2, 4
+  4, 3, 2, 1, 0, 1, 2, 3, 4,
+  4, 3, 2, 1, 0, 1, 2, 3, 4,
+  4, 3, 2, 1, 0, 1, 2, 3, 4
 ];
 
