# ==============================================================================
# ASTRO SIVAM - Production Apache / cPanel / LiteSpeed .htaccess Configuration
# ==============================================================================

# NOTE (2026-10-12): ServerSignature/ServerTokens are server-config-only; in .htaccess they make Apache 500 on every request. Do not add them back here.


# ------------------------------------------------------------------------------
# 1. Directory Listings & Sensitive Files Security
# ------------------------------------------------------------------------------
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

# Block access to hidden, environment, backup and sensitive source files.
# Never expose source maps or executable build artifacts from the static site.
<FilesMatch "(\.(map|cjs|sql|env|log|lock|ini|conf|bak|sh|md|git|key|yml|yaml|htaccess|htpasswd)|composer\.(json|lock)|package\.json|tsconfig\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 2. HTTP Security Headers
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Enforce HTTPS across domain & subdomains for 1 year
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS

  # Protect against clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"

  # Prevent MIME type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Referrer policy for secure transitions
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Restrict unauthorized browser features
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"

  # Legacy XSS protection for older browsers
  Header always set X-XSS-Protection "1; mode=block"

  # Content-Security-Policy (H2): XSS containment layer for the SPA.
  # The app renders user-controlled content (names, messages, order data) and
  # keeps sessions in an httpOnly cookie, so every script/source that may load
  # is explicitly allow-listed here:
  #   script-src  - own bundles, Google Sign-In, Razorpay checkout
  #   style-src   - own CSS, React inline styles, Google Fonts CSS used only by report documents
  #   font-src    - self-hosted app fonts, report Google Fonts files, inline data: fonts
  #   img-src     - own assets, data:/blob: exports, map tiles + provider logos (https:)
  #   connect-src - /api (self), Google sign-in, Razorpay, the Leaflet geocoders
  #   frame-src   - PDF preview iframes (blob:), Google + Razorpay payment frames
  # JSON-LD in <head> is a non-executable data block and is not affected by
  # script-src. Keep this policy in sync with the deployment notes in
  # AUTH_SECURITY_HARDENING.md when adding new third-party origins.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' https://accounts.google.com https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https://accounts.google.com https://api.razorpay.com https://checkout.razorpay.com https://nominatim.openstreetmap.org https://photon.komoot.io; frame-src 'self' blob: https://accounts.google.com https://api.razorpay.com https://checkout.razorpay.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
</IfModule>

# ------------------------------------------------------------------------------
# 2b. ModSecurity / WAF exemptions for search-engine crawlers (2026-10-17)
# ------------------------------------------------------------------------------
# WHY THIS BLOCK EXISTS
# ---------------------
# Google Search Console reported the sitemap as unreadable / "406 Not
# Acceptable". The sitemap itself was fine; the REQUEST was being rejected.
# Shared cPanel hosts run ModSecurity (or a host WAF) that scores a request by
# the SHAPE of its headers: a real browser sends User-Agent, Accept,
# Accept-Language, Accept-Encoding and Sec-Fetch-*, while a crawler, a
# Search Console fetcher or a monitoring probe sends a bare User-Agent (or
# nothing else). The generic "missing / invalid header" rules then trip and
# the WAF answers 406. The rules that fire are, depending on the ruleset
# version in use:
#
#   200002-200006  CRS 2.x "protocol enforcement" (invalid/missing User-Agent,
#                  Accept, Accept-Encoding)
#   920350 920420  CRS 3.x "protocol enforcement" (header/cookie not allowed)
#   949110          CRS 3.x bot fingerprinting (generic non-browser client)
#   980130          CRS 3.x anomaly score exceeded (the usual 406 trigger)
#
# WHAT THIS BLOCK DOES (and deliberately does NOT do)
# ---------------------------------------------------
# It does NOT switch the WAF off. `SecRuleEngine Off` / `SecFilterEngine Off`
# would remove a real protection layer from the whole site, which is exactly
# the "fix" that turns a crawler problem into a security problem. Instead:
#
#   1. The two crawl-critical documents (sitemap.xml, robots.txt) are exempt
#      from the header-shape rules. They are static text; no header rule
#      protects them, and every search engine fetches them with a non-browser
#      client. SecRuleRemoveById is a CONFIG-time removal for that file, so it
#      works no matter in which order the server-level rules run.
#   2. Verified search-engine crawlers are allowed past the same header-shape
#      rules site-wide, via ctl:ruleRemoveById. Only the header-shape rules
#      are removed — every injection, traversal and bot-blocking rule still
#      applies to crawlers.
#
# IF A 406 STILL APPEARS: the host's ruleset uses an ID that is not listed
# here. Find it in the ModSecurity audit log and add it to the list below
# (docs/SITEMAP_406_WAF_FIX_AND_GSC_SUBMISSION.md has the exact commands).

# The block is written twice on purpose: ModSecurity 2 loads as
# mod_security2.c and ModSecurity 3 as mod_security3.c, and <IfModule> matches
# the module FILE name. A single <IfModule mod_security.c> (a very common
# copy-paste) matches NOTHING on most servers and silently disables the whole
# exemption.
<IfModule mod_security2.c>
  # 1. The crawl-critical documents: exempt from the header-shape rules.
  <FilesMatch "^(sitemap\.xml|robots\.txt)$">
    SecRuleRemoveById 200002 200003 200004 200005 200006 920350 920420 949110 980130
  </FilesMatch>

  # 2. Verified search-engine crawlers: skip the header-shape rules only.
  #    Phase 1 so the removal is in place before the phase-2 anomaly-scoring
  #    and bot-fingerprint rules (949110, 980130) evaluate the request.
  SecRule REQUEST_HEADERS:User-Agent "@rx (?i)\b(googlebot|google-inspectiontool|googleother|adsbot-google|google-extended|bingbot|bingpreview|adidxbot|slurp|duckduckbot|baiduspider|yandex(bot|images)|applebot|facebookexternalhit|twitterbot|linkedinbot|whatsapp|telegrambot|discordbot|petalbot|semrushbot|ahrefsbot|mj12bot|dotbot)\b" \
    "id:1002001,phase:1,pass,nolog,t:none,ctl:ruleRemoveById=200002,ctl:ruleRemoveById=200003,ctl:ruleRemoveById=200004,ctl:ruleRemoveById=200005,ctl:ruleRemoveById=200006,ctl:ruleRemoveById=920350,ctl:ruleRemoveById=920420,ctl:ruleRemoveById=949110,ctl:ruleRemoveById=980130"
</IfModule>

<IfModule mod_security3.c>
  # Same exemptions for ModSecurity 3 (variable syntax differs: v3 uses
  # REQUEST_HEADERS.<name> instead of REQUEST_HEADERS:<name>).
  <FilesMatch "^(sitemap\.xml|robots\.txt)$">
    SecRuleRemoveById 200002 200003 200004 200005 200006 920350 920420 949110 980130
  </FilesMatch>

  SecRule REQUEST_HEADERS.User-Agent "@rx (?i)\b(googlebot|google-inspectiontool|googleother|adsbot-google|google-extended|bingbot|bingpreview|adidxbot|slurp|duckduckbot|baiduspider|yandex(bot|images)|applebot|facebookexternalhit|twitterbot|linkedinbot|whatsapp|telegrambot|discordbot|petalbot|semrushbot|ahrefsbot|mj12bot|dotbot)\b" \
    "id:1002002,phase:1,pass,nolog,t:none,ctl:ruleRemoveById=200002,ctl:ruleRemoveById=200003,ctl:ruleRemoveById=200004,ctl:ruleRemoveById=200005,ctl:ruleRemoveById=200006,ctl:ruleRemoveById=920350,ctl:ruleRemoveById=920420,ctl:ruleRemoveById=949110,ctl:ruleRemoveById=980130"
</IfModule>

# ------------------------------------------------------------------------------
# 3. Rewrite Engine, Canonical HTTPS & Non-WWW Redirection, SPA Fallback
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # (c0) One canonical URL per page. The prerendered route documents live in
  # pages/<route>.html (see rule (g)), so their physical URLs must 301 to the
  # clean path — otherwise every page would be indexable twice. This must run
  # BEFORE the pre-compression negotiation below (which would otherwise serve
  # a .br sibling directly), and it tests THE_REQUEST so the internal
  # /services -> /pages/services.html rewrite never re-triggers it. The
  # optional pages/ prefix also keeps any legacy root-level .html URL canonical.
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
  RewriteRule ^ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/(?:pages/)?(services|birth-jathagam|marriage-compatibility|baby-naming|muhurtham|how-it-works|about|team|contact|login|register|dashboard|admin|privacy-policy|terms|payment-policy|refund-policy)\.html[\s?]
  RewriteRule ^ /%1 [R=301,L]

  # Prevent mod_deflate / mod_brotli from double-compressing negotiated .br / .gz siblings.
  # Crucial for cPanel / LiteSpeed hosts: prevents double-gzip encoding causing ERR_CONTENT_DECODING_FAILED.
  RewriteCond %{HTTP:Accept-Encoding} (br|gzip) [NC]
  RewriteCond %{REQUEST_FILENAME}\.(br|gz) -s
  RewriteRule ^ - [E=no-gzip:1,E=no-brotli:1]

  # (0-crawl) CRAWL-FACING TEXT DOCUMENTS ARE ALWAYS SERVED AS PLAIN BYTES.
  # Fix for the sitemap.xml 406 / "Sitemap could not be read" failure
  # (2026-10-17): /sitemap.xml was answered with "Content-Type:
  # application/x-gzip" and NO Content-Encoding header, because the
  # pre-compression negotiation below swapped in the gzip sibling while the
  # Content-Encoding/Content-Type mapping only covered .js/.css/.html. Google
  # received gzip bytes where XML was expected and could not parse the file.
  # A crawler-facing document must be boring: no sibling negotiation, no
  # on-the-fly compression, one obvious content type. 2.4 KB uncompressed
  # costs nothing next to a sitemap that no search engine can read.
  # The condition uses REQUEST_FILENAME (the on-disk path, no query string).
  RewriteCond %{REQUEST_FILENAME} \.(xml|txt)$
  RewriteRule ^ - [E=no-gzip:1,E=no-brotli:1]

  # (0) Serve PRE-COMPRESSED assets by content negotiation. This MUST run before
  # the "existing file" rule (e) below, which would otherwise stop processing and
  # return the uncompressed original. The build emits <file>.br / <file>.gz for
  # every text asset (vite-plugin-compress.ts); index.html always references the
  # original URL, so we transparently swap in the compressed sibling here.
  # Crawl-facing text documents (.xml/.txt) are excluded — see (0-crawl) above.
  RewriteCond %{REQUEST_FILENAME} !\.(xml|txt)$
  RewriteCond %{HTTP:Accept-Encoding} br [NC]
  RewriteCond %{REQUEST_FILENAME}\.br -s
  RewriteRule ^(.*)\.(js|mjs|css|html|json|svg|txt|xml|webmanifest|wasm|map)$ /$1.$2.br [L]

  RewriteCond %{REQUEST_FILENAME} !\.(xml|txt)$
  RewriteCond %{HTTP:Accept-Encoding} gzip [NC]
  RewriteCond %{REQUEST_FILENAME}\.gz -s
  RewriteRule ^(.*)\.(js|mjs|css|html|json|svg|txt|xml|webmanifest|wasm|map)$ /$1.$2.gz [L]

  # (a) Force Canonical Non-WWW (e.g. www.astrosivam.com -> astrosivam.com)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # (b) Force HTTP to HTTPS (301 Permanent Redirect)
  RewriteCond %{HTTPS} !on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # (c) 301 Redirect retired / legacy services to /services
  RewriteRule ^(eclipse-guide|eclipse|kiraganam)/?$ /services [R=301,L,NC]

  # (c2) Legacy URL aliases -> their canonical clean URL. The SPA used to
  # resolve these client-side; a 301 keeps old links working and stops each
  # alias from existing as its own (duplicate) indexable URL.
  RewriteRule ^home/?$ / [R=301,L]
  RewriteRule ^(subha-muhurtham|muhurtha)/?$ /muhurtham [R=301,L]
  RewriteRule ^(privacy|policy-privacy)/?$ /privacy-policy [R=301,L]
  RewriteRule ^(terms-and-conditions|policy-terms)/?$ /terms [R=301,L]
  RewriteRule ^policy-payment/?$ /payment-policy [R=301,L]
  RewriteRule ^policy-refund/?$ /refund-policy [R=301,L]
  RewriteRule ^customer-dashboard/?$ /dashboard [R=301,L]
  RewriteRule ^(admin-portal|admin\.php)/?$ /admin [R=301,L]
  RewriteRule ^(logos|brand-logos|logo-concepts)/?$ / [R=301,L]

  # (d) Pass backend PHP API requests directly to PHP router (do not rewrite to index.html)
  RewriteRule ^api/ - [L,NC]
  RewriteRule ^api$ - [L,NC]

  # (d2) Missing static build assets must 404, never fall through to the SPA
  # shell. The "existing file" rule (e) serves real assets; only files that do
  # not exist on disk are rejected here, so a stale deploy can't turn a 404 into
  # a 200 "app shell" response.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^assets/ - [R=404,L,NC]

  # (e) Serve real existing static files directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # (f) Serve real existing directories directly (except virtual SPA route collisions)
  RewriteCond %{REQUEST_URI} !^/(admin|admin-portal|dashboard|customer-dashboard|login|register|birth-jathagam|marriage-compatibility|baby-naming|muhurtham|subha-muhurtham|services|about|contact|pricing|team)($|/.*)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # (g) PRERENDERED ROUTE DOCUMENTS (SEO audit fix 2026-10-14, findings 1+2):
  # scripts/prerender.mjs writes pages/<route>.html per public route — each
  # with its own <title>, meta description, self-referencing canonical and
  # real body content — and the clean URL is internally rewritten to it. The
  # browser keeps the clean URL; crawlers stop receiving the empty SPA shell.
  # One shared pages/ folder avoids one folder per route while keeping the
  # prerendered HTML and compressed siblings out of the cPanel root.
  RewriteCond %{DOCUMENT_ROOT}/pages/$1.html -f
  RewriteRule ^(services|birth-jathagam|marriage-compatibility|baby-naming|muhurtham|how-it-works|about|team|contact|login|register|dashboard|admin|privacy-policy|terms|payment-policy|refund-policy)/?$ /pages/$1.html [L]

  # (g2) SPA Fallback: recognized client-side routes without a prerendered
  # document fall back to root index.html. This list mirrors the path->route
  # map in src/App.tsx. Anything else falls through to ErrorDocument 404.
  RewriteRule ^/?$ /index.html [L]
  RewriteRule ^(services|birth-jathagam|marriage-compatibility|baby-naming|muhurtham|how-it-works|about|team|contact|login|register|dashboard|admin|privacy-policy|terms|payment-policy|refund-policy|design-preview)/?$ /index.html [L]
  RewriteRule ^pricing$ /index.html [L]
</IfModule>

# ------------------------------------------------------------------------------
# 3b. True 404 for anything not matched above.
# ------------------------------------------------------------------------------
# With mod_rewrite the subrequest to ErrorDocument is internal, so the browser
# still receives HTTP 404 while getting a friendly, self-contained page. The
# page carries <meta name="robots" content="noindex"> and loads no scripts, so a
# stray URL is never indexed and never executes third-party code.
ErrorDocument 404 /404.html

# ------------------------------------------------------------------------------
# 4. MIME Types Configuration
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/json .json
  AddType application/xml .xml
  AddType text/plain .txt
  AddType application/manifest+json .webmanifest
  AddType application/wasm .wasm
  AddType font/woff .woff
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/avif .avif
</IfModule>

# ------------------------------------------------------------------------------
# 5. Pre-compressed asset headers (Brotli + gzip) and on-the-fly fallback
# ------------------------------------------------------------------------------
# The content-negotiation REWRITE that maps a request to its .br/.gz sibling
# lives at the TOP of section 3 (rule 0), because it must run before the
# "serve existing file" rule. Only the response headers and the on-the-fly
# fallback filters belong here.
<IfModule mod_headers.c>
  # The pre-compressed response must carry its true encoding, or the browser
  # will hand raw Brotli/gzip bytes to the JS/CSS parser.
  #
  # CACHE CORRECTNESS — this matters more with a CDN in front. Rule 0 above
  # resolves ONE URL (/assets/app.js) to one of SEVERAL encodings depending on
  # Accept-Encoding. A shared cache that does not key on Accept-Encoding will
  # hand the first visitor's Brotli body to a client that only accepts gzip,
  # and the bundle fails to parse (blank page). Cloudflare's edge cache honours
  # Vary: Accept-Encoding, so every negotiated variant must declare it.
  # mod_deflate/mod_brotli set this themselves for on-the-fly responses; the
  # pre-compressed siblings below are served WITHOUT those filters, so they must
  # say it explicitly.
  # Critical protection against double-compression:
  # When Apache serves a .br or .gz file, mod_deflate/mod_brotli must NEVER re-compress it!
  <FilesMatch "\.(br|gz)$">
    <IfModule mod_env.c>
      SetEnv no-gzip 1
      SetEnv no-brotli 1
    </IfModule>
    <IfModule mod_setenvif.c>
      SetEnvIfNoCase Request_URI "\.(br|gz)$" no-gzip=1 no-brotli=1
    </IfModule>
    SetOutputFilter None
  </FilesMatch>
  <FilesMatch "\.(js|mjs|css|html|json|svg|txt|xml|webmanifest|wasm)(\.br|\.gz)?$">
    Header merge Vary Accept-Encoding
  </FilesMatch>
  <FilesMatch "\.js\.br$">
    Header set Content-Encoding br
    Header set Content-Type application/javascript
  </FilesMatch>
  <FilesMatch "\.css\.br$">
    Header set Content-Encoding br
    Header set Content-Type text/css
  </FilesMatch>
  <FilesMatch "\.html\.br$">
    Header set Content-Encoding br
    Header set Content-Type text/html
  </FilesMatch>
  <FilesMatch "\.js\.gz$">
    Header set Content-Encoding gzip
    Header set Content-Type application/javascript
  </FilesMatch>
  <FilesMatch "\.css\.gz$">
    Header set Content-Encoding gzip
    Header set Content-Type text/css
  </FilesMatch>
  <FilesMatch "\.html\.gz$">
    Header set Content-Encoding gzip
    Header set Content-Type text/html
  </FilesMatch>

  # Every OTHER type the negotiation rule above can still reach must declare
  # its true Content-Encoding AND the Content-Type of the ORIGINAL file, for
  # the same reason: a sibling served without the encoding header hands the
  # client raw Brotli/gzip bytes. This is exactly how /sitemap.xml started
  # answering "Content-Type: application/x-gzip" with no Content-Encoding and
  # became unreadable to Google — a mapping that existed for .js/.css/.html
  # but not for the type that actually mattered. Keep this list in sync with
  # the extension list of the negotiation rule, or REMOVE the extension from
  # the negotiation rule instead.
  <FilesMatch "\.mjs\.br$">
    Header set Content-Encoding br
    Header set Content-Type application/javascript
  </FilesMatch>
  <FilesMatch "\.mjs\.gz$">
    Header set Content-Encoding gzip
    Header set Content-Type application/javascript
  </FilesMatch>
  <FilesMatch "\.json\.br$">
    Header set Content-Encoding br
    Header set Content-Type application/json
  </FilesMatch>
  <FilesMatch "\.json\.gz$">
    Header set Content-Encoding gzip
    Header set Content-Type application/json
  </FilesMatch>
  <FilesMatch "\.svg\.br$">
    Header set Content-Encoding br
    Header set Content-Type image/svg+xml
  </FilesMatch>
  <FilesMatch "\.svg\.gz$">
    Header set Content-Encoding gzip
    Header set Content-Type image/svg+xml
  </FilesMatch>
  <FilesMatch "\.wasm\.br$">
    Header set Content-Encoding br
    Header set Content-Type application/wasm
  </FilesMatch>
  <FilesMatch "\.wasm\.gz$">
    Header set Content-Encoding gzip
    Header set Content-Type application/wasm
  </FilesMatch>
  <FilesMatch "\.webmanifest\.br$">
    Header set Content-Encoding br
    Header set Content-Type application/manifest+json
  </FilesMatch>
  <FilesMatch "\.webmanifest\.gz$">
    Header set Content-Encoding gzip
    Header set Content-Type application/manifest+json
  </FilesMatch>

  # The crawl-critical documents get an explicit, host-independent content type.
  # Some cPanel/LiteSpeed mime.types map .xml to text/xml and others to
  # application/xml — both are valid for a sitemap — but the type must never be
  # application/x-gzip, which is what the compressed sibling used to produce.
  <FilesMatch "^sitemap\.xml$">
    Header set Content-Type "application/xml"
  </FilesMatch>
  <FilesMatch "^robots\.txt$">
    Header set Content-Type "text/plain"
  </FilesMatch>
</IfModule>

# Optional native Brotli output filter when the host provides mod_brotli. Harmless
# when absent; still useful for any asset the build did not pre-compress.
<IfModule mod_brotli.c>
  SetEnvIfNoCase Request_URI "\.(br|gz)$" no-brotli dont-vary
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ------------------------------------------------------------------------------
# 5b. On-the-fly gzip fallback (only for files with no pre-compressed sibling)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  SetEnvIfNoCase Request_URI "\.(br|gz)$" no-gzip dont-vary
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>

# ------------------------------------------------------------------------------
# 6. Browser Caching
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Static Assets (immutable Vite bundles)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  # Apache serves .js as text/javascript on current mime.types (it used to be
  # application/javascript, which is why both are listed). Without this line the
  # hashed Vite bundles fell through to ExpiresDefault (1 month) — a shorter
  # browser TTL than the content-hashed filenames allow, and a needless
  # revalidation round trip on every repeat visit.
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  # Dynamic HTML should revalidate
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
