# ASTRO SIVAM — environment values for the PHP API on cPanel/BigRock.
# BigRock serves the compiled frontend as static files and runs the backend with
# PHP/MySQL. No Node server, npm process, or Redis service runs on the host.
# Keep real values in the hosting environment or api/config.php only; never
# commit them to this file or the repository.

# ---------------------------------------------------------------------------
# MySQL and authentication
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=
DB_PORT=3306
# Optional; if unset PHP creates a private key under api/astrology/tmp/.
APP_SECRET_KEY=

# ---------------------------------------------------------------------------
# Social sign-in (optional)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---------------------------------------------------------------------------
# Astrology conventions
# ---------------------------------------------------------------------------
# TRUE = osculating lunar node; MEAN = classical mean node (default).
ASTRO_RAHU_NODE_TYPE=MEAN
# Optional Kuja/Manglik house list override; default is defined by AstroEngine.
ASTRO_KUJA_HOUSES=

# ---------------------------------------------------------------------------
# Payment provider configuration (admin settings are also supported)
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ---------------------------------------------------------------------------
# Optional notifications and contact email
# ---------------------------------------------------------------------------
CONTACT_INQUIRY_TO=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
VIBER_AUTH_TOKEN=
VIBER_SENDER_NAME=ASTRO SIVAM

# Set to 1 only while checking the PHP mPDF installation; this diagnostic
# endpoint prints hosting paths and must be disabled again after use.
ASTROSIVAM_DIAGNOSTICS=

# ---------------------------------------------------------------------------
# Source-based Astrologer chat (local-only; no external AI or API key)
# ---------------------------------------------------------------------------
# Replies are assembled from the local chart engine, knowledge/ai-astrologer
# rules, remedies, report readings, and verified source references. The backend
# does not read AI provider credentials or make model calls.
# Questions are UNLIMITED for every entitled customer and for admins; there is
# no daily-cap variable any more. Access is bounded only by authentication,
# the delivered-report entitlement and the 7-day chat window.
#
# If the chat does not answer, sign in as an admin and run:
#   /api/ai_astrologer.php?action=diagnose
# This checks PHP mbstring and the deployed local knowledge files; it never
# makes an outbound request. See docs/AI_CHAT_NOT_REPLYING_FIX.md.

# ---------------------------------------------------------------------------
# First-admin provisioning (CLI only; do not make this a public endpoint)
# ---------------------------------------------------------------------------
ASTROSIVAM_ADMIN_EMAIL=
ASTROSIVAM_ADMIN_NAME=
ASTROSIVAM_ADMIN_PASSWORD=
