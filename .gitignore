dist/
# Scratch build outputs (e.g. `vite build --outDir dist-scratch`): Tailwind v4's
# automatic content scanner and tests/retired-branding-guard read every
# non-ignored directory, so a stray build tree silently changes the generated
# CSS and thus content hashes of a real build (seen while bisecting the
# __VITE_PRELOAD__ incident).
dist-*/
dist.zip
public/dist.zip
public/dist_and_api.zip
public_html/
public_html_combined.zip

# PHP runtime signing key (never commit)
api/astrology/tmp/app_secret_key.txt

# Backup generations written by scripts/backup/astro_site_backup.sh (customer
# data + support documents). These live on the host only, under the directory
# api/.htaccess already denies over HTTP.
api/storage/backups/
# Astrology team portraits uploaded through the admin panel live on the server
# (api/uploads/team/), never in Git. Only the folder's execution guards ship.
api/uploads/team/*
!api/uploads/team/.htaccess

# Python bytecode cache from the scripts/ asset builders
__pycache__/
*.pyc

# Locally generated report previews / verification harness output (repository root)
/tmp/

# PHP runtime directory: signing keys are generated on the host and never
# committed. Only its Apache access-control file is tracked.
api/astrology/tmp/*
!api/astrology/tmp/.htaccess

# Regenerable TypeScript/PHP parity output (the committed contract is in fixtures).
tests/fixtures/parity-node.json
tests/fixtures/parity-php.json

# Written on every run of tests/ai-astrologer-php-runtime.test.ts by the wasm PHP
# probe. The probe itself is tracked; its output is not.
tests/fixtures/php-ai-probes/out.json
tests/fixtures/php-ai-probes/out-coverage.json
tests/fixtures/php-ai-probes/out-kb.json
tests/fixtures/php-ai-probes/out-guided.json
tests/fixtures/php-ai-probes/out-guided-focus.json
tests/fixtures/php-ai-probes/out-lint.json
tests/fixtures/php-ai-probes/out-service-reports.json
tests/fixtures/php-ai-probes/out-birth-chart-sample.json

# Written on every run of tests/refund-policy-php-runtime.test.ts by the refund
# wasm PHP probe (scripts/php-refund-policy-check.mjs). The probe is tracked;
# its output is not.
tests/fixtures/php-refund-probes/out.json

