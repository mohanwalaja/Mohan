# ASTRO SIVAM - astrology team portraits (admin uploads).
#
# These files are meant to be SERVED as images and nothing else.
# An uploaded image URL (/api/uploads/team/<hex>.jpg) is immutable and unique;
# a replaced photo is a new URL, so 30-day client caching is safe.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py .sh
RemoveType .php .phtml .phar

# Belt and braces: block any script-ish file from ever executing or being read
<FilesMatch "\.(php|phtml|php[0-9]|phar|cgi|pl|py|sh|inc|shtml|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header set Cache-Control "public, max-age=2592000"
</IfModule>
